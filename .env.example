# Database
# Dev (SQLite):
DATABASE_URL="file:./dev.db"
# Prod (PostgreSQL via Docker Compose — set automatically in compose):
# DATABASE_URL="postgresql://yunmeng:yunmeng@db:5432/yunmeng?schema=public"

# Auth (production: use a long random string)
NEXTAUTH_SECRET="please-change-this-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Docker Compose overrides (optional)
# APP_PORT=3000
# DB_PORT=5432
# POSTGRES_PASSWORD=yunmeng
# RUN_SEED=0

# Payment
PAYMENT_MODE="mock"
# PAYMENT_MODE="alipay"
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
