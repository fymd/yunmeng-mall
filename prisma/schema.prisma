// Prisma schema for Yunmeng AI Top-up Mall
// Local: provider = "sqlite", url = "file:./dev.db"
// Docker build auto-switches to postgresql

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum StockStatus {
  PLENTY
  SUFFICIENT
  LOW
  PREORDER
  SOLD_OUT
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CardStatus {
  UNUSED
  SOLD
  VOID
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  sort      Int       @default(0)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  name        String
  description String      @default("")
  price       Float
  stockStatus StockStatus @default(PLENTY)
  tags        String      @default("")
  enabled     Boolean     @default(true)
  imageUrl    String?
  /// When true, assign one CardCode on payment and set order DELIVERED
  autoDeliver Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]
  cards       CardCode[]
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  amount          Float
  status          OrderStatus @default(PENDING)
  remark          String      @default("")
  /// Snapshot of delivered card/secret for buyer display
  deliveryContent String      @default("")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paidAt          DateTime?
  card            CardCode?
}

model CardCode {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  code      String
  status    CardStatus @default(UNUSED)
  orderId   String?    @unique
  order     Order?     @relation(fields: [orderId], references: [id])
  soldAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([productId, status])
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
